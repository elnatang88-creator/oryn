# Copy to deploy/.env (or run ./gen-env.sh). Never commit the real file.
ORYN_DOMAIN=oryn.example.com
ORYN_SECRET=
CRON_SECRET=
POSTGRES_ADMIN_PASSWORD=
ORYN_DB_PASSWORD=
ORYN_SEED_DEMO=false
BACKUP_KEEP_DAYS=14
# Email (own SMTP server). Leave EMAIL_TRANSPORT empty to record mail as skipped.
EMAIL_TRANSPORT=
SMTP_URL=
EMAIL_FROM=ORYN <no-reply@oryn.example.com>
# AI assistance (optional)
ORYN_AI_PROVIDER=
ANTHROPIC_API_KEY=
