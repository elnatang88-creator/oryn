<div class="container section-padding" style="max-width:440px;">
  <h1 class="h3" style="text-align:center;margin-bottom:12px;">Reset Password</h1>
  <p style="text-align:center;color:var(--color-text-secondary);margin-bottom:28px;">Enter a new password for {{ email }}.</p>

  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="margin-bottom:16px;">
      <label for="ResetPassword">New password</label>
      <input type="password" name="customer[password]" id="ResetPassword" class="input" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirmation">Confirm password</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" class="input" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary btn--block btn--lg" style="margin-top:20px;">Reset Password</button>
  {%- endform -%}
</div>
