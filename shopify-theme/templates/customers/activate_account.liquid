<div class="container section-padding" style="max-width:440px;">
  <h1 class="h3" style="text-align:center;margin-bottom:12px;">Activate Account</h1>
  <p style="text-align:center;color:var(--color-text-secondary);margin-bottom:28px;">Create a password to activate your account.</p>

  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="margin-bottom:16px;">
      <label for="ActivatePassword">Password</label>
      <input type="password" name="customer[password]" id="ActivatePassword" class="input" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ActivatePasswordConfirmation">Confirm password</label>
      <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirmation" class="input" autocomplete="new-password" required>
    </div>
    <div class="buy-box__row" style="margin-top:20px;">
      <button type="submit" name="accept" class="btn btn--primary btn--lg">Activate Account</button>
      <button type="submit" name="decline" class="btn btn--secondary">Decline Invitation</button>
    </div>
  {%- endform -%}
</div>
