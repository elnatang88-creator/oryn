<div class="container section-padding">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:32px;">
    <h1 class="h3">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="btn btn--secondary btn--sm">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="surface" style="padding:24px;margin-bottom:32px;">
    <h2 class="h4" style="margin-bottom:12px;">{{ 'customer.account.details' | t }}</h2>
    <p style="color:var(--color-text-secondary);">{{ customer.name }}</p>
    <p style="color:var(--color-text-secondary);">{{ customer.email }}</p>
    <a href="{{ routes.account_addresses_url }}" style="color:var(--color-accent-secondary);font-size:13px;">Manage addresses</a>
  </div>

  <h2 class="h4" style="margin-bottom:16px;">{{ 'customer.account.orders' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <div class="surface" style="overflow-x:auto;">
      <table style="width:100%;font-size:14px;">
        <thead>
          <tr style="border-bottom:1px solid var(--color-border);text-align:left;">
            <th style="padding:14px;">Order</th>
            <th style="padding:14px;">Date</th>
            <th style="padding:14px;">Payment</th>
            <th style="padding:14px;">Fulfillment</th>
            <th style="padding:14px;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-bottom:1px solid var(--color-border);">
              <td style="padding:14px;"><a href="{{ order.customer_url }}" style="color:var(--color-accent-secondary);">{{ order.name }}</a></td>
              <td style="padding:14px;color:var(--color-text-secondary);">{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td style="padding:14px;color:var(--color-text-secondary);">{{ order.financial_status_label }}</td>
              <td style="padding:14px;color:var(--color-text-secondary);">{{ order.fulfillment_status_label }}</td>
              <td style="padding:14px;">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- else -%}
    <p style="color:var(--color-text-secondary);">No orders yet.</p>
  {%- endif -%}
</div>
