{%- comment -%}
  Reusable product card.
  Usage: {% render 'product-card', product: product %}
  Optional: badge_override (string), lazy: true/false
{%- endcomment -%}
{%- liquid
  assign ratio = settings.product_image_ratio | default: 'portrait'
  assign featured_image = product.featured_image
  assign secondary_image = product.images[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="product-card" data-product-card data-product-id="{{ product.id }}">
  <div class="product-card__media" data-ratio="{{ ratio }}">
    <a href="{{ product.url }}" class="product-card__media-link" aria-hidden="true" tabindex="-1">
      {%- if featured_image -%}
        <img
          class="product-card__img--primary"
          src="{{ featured_image | image_url: width: 600 }}"
          srcset="{{ featured_image | image_url: width: 400 }} 400w, {{ featured_image | image_url: width: 600 }} 600w, {{ featured_image | image_url: width: 800 }} 800w"
          sizes="(min-width: 990px) 25vw, (min-width: 750px) 40vw, 62vw"
          alt="{{ featured_image.alt | default: product.title | escape }}"
          width="{{ featured_image.width }}"
          height="{{ featured_image.height }}"
          loading="{% if lazy == false %}eager{% else %}lazy{% endif %}"
        >
      {%- else -%}
        <div class="shimmer" style="width:100%;height:100%;"></div>
      {%- endif -%}
      {%- if secondary_image -%}
        <img
          class="product-card__img--secondary"
          src="{{ secondary_image | image_url: width: 600 }}"
          alt=""
          loading="lazy"
          aria-hidden="true"
        >
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if on_sale -%}<span class="badge badge--sale">{{ 'products.product.sale' | t }}</span>{%- endif -%}
      {%- if product.metafields.custom.best_seller -%}<span class="badge badge--bestseller">{{ 'products.product.best_seller' | t }}</span>{%- endif -%}
      {%- if product.created_at_days_ago <= 30 -%}<span class="badge badge--new">{{ 'products.product.new' | t }}</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
    </div>

    <button
      type="button"
      class="product-card__wishlist"
      data-wishlist-toggle="{{ product.handle }}"
      aria-label="{{ 'products.product.wishlist_add' | t }}"
    >
      {% render 'icon', name: 'heart' %}
    </button>

    {%- if settings.enable_quick_view -%}
      <button
        type="button"
        class="product-card__wishlist"
        style="top:54px;"
        data-quick-view="{{ product.url }}"
        aria-label="{{ 'products.product.quick_view' | t }}"
      >
        {% render 'icon', name: 'search' %}
      </button>
    {%- endif -%}

    {%- if settings.enable_quick_add and product.available -%}
      <div class="product-card__quick-add">
        {%- if product.has_only_default_variant -%}
          <button type="button" class="btn btn--secondary btn--sm btn--block" data-quick-add-button data-variant-id="{{ product.selected_or_first_available_variant.id }}">
            {{ 'products.product.quick_add' | t }}
          </button>
        {%- else -%}
          <a href="{{ product.url }}" class="btn btn--secondary btn--sm btn--block">{{ 'products.product.choose_options' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <div class="product-card__body">
    {%- if settings.show_vendor -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {%- if settings.show_rating -%}
      <div class="product-card__rating">
        {% render 'rating-stars', product: product %}
      </div>
    {%- endif -%}
    {% render 'price', product: product, class: 'product-card__price' %}
  </div>
</div>
