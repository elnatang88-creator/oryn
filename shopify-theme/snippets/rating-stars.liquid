{%- comment -%}
  Renders star rating from product.metafields.reviews.rating (Shopify product rating metafield,
  populated by the Shopify Product Reviews app or similar). Falls back gracefully if absent.
  Usage: {% render 'rating-stars', product: product %}
{%- endcomment -%}
{%- liquid
  assign rating_metafield = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating_metafield and count > 0 -%}
  {%- assign rating_value = rating_metafield.rating -%}
  {%- assign rating_max = rating_metafield.scale_max | default: 5 -%}
  <span class="rating-stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max, count: count }}">
    {%- assign full_stars = rating_value | floor -%}
    {%- for i in (1..5) -%}
      {%- if i <= full_stars -%}
        {% render 'icon', name: 'star', class: 'is-full' %}
      {%- else -%}
        {% render 'icon', name: 'star', class: 'is-empty' %}
      {%- endif -%}
    {%- endfor -%}
  </span>
  {%- if show_count != false -%}
    <span class="rating-count">({{ count }})</span>
  {%- endif -%}
{%- endif -%}
