{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'heart' %}
  Accepts optional class: {% render 'icon', name: 'heart', class: 'my-class' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = class | default: ''
-%}
<svg class="icon icon-{{ name }} {{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    {%- when 'heart' -%}
      <path d="M12 20.5s-7.5-4.6-10-9.3C.4 8 1.7 4.3 5.2 3.4c2.1-.5 4.2.4 5.4 2.1l1.4 1.9 1.4-1.9c1.2-1.7 3.3-2.6 5.4-2.1 3.5.9 4.8 4.6 3.2 7.8-2.5 4.7-10 9.3-10 9.3z"></path>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
    {%- when 'bag' -%}
      <path d="M6 8h12l1 13H5L6 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
    {%- when 'menu' -%}
      <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
    {%- when 'close' -%}
      <line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line>
    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"></polyline>
    {%- when 'chevron-right' -%}
      <polyline points="9 6 15 12 9 18"></polyline>
    {%- when 'chevron-left' -%}
      <polyline points="15 6 9 12 15 18"></polyline>
    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"></line>
    {%- when 'star' -%}
      <polygon points="12 2 15.1 8.6 22 9.3 17 14.1 18.3 21 12 17.6 5.7 21 7 14.1 2 9.3 8.9 8.6"></polygon>
    {%- when 'truck' -%}
      <rect x="1" y="7" width="14" height="11" rx="1"></rect><path d="M15 10h4l3 3v5h-7z"></path><circle cx="6" cy="20" r="1.6"></circle><circle cx="17.5" cy="20" r="1.6"></circle>
    {%- when 'shield' -%}
      <path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3z"></path>
    {%- when 'lock' -%}
      <rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
    {%- when 'headset' -%}
      <path d="M4 13v-1a8 8 0 0 1 16 0v1"></path><rect x="2" y="13" width="5" height="7" rx="2"></rect><rect x="17" y="13" width="5" height="7" rx="2"></rect>
    {%- when 'gift' -%}
      <rect x="3" y="9" width="18" height="12" rx="1"></rect><path d="M3 9h18v4H3z"></path><path d="M12 9v12"></path><path d="M12 9C9 9 8 6 9.5 4.5S13 4 12 9zM12 9c3 0 4-3 2.5-4.5S11 4 12 9z"></path>
    {%- when 'sparkle' -%}
      <path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8L12 2z"></path>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"></circle><line x1="3" y1="12" x2="21" y2="12"></line><path d="M12 3c2.5 2.6 4 6 4 9s-1.5 6.4-4 9c-2.5-2.6-4-6-4-9s1.5-6.4 4-9z"></path>
    {%- when 'return' -%}
      <path d="M3 10h11a5 5 0 0 1 0 10H9"></path><polyline points="7 6 3 10 7 14"></polyline>
    {%- when 'droplet' -%}
      <path d="M12 2s7 8.2 7 13a7 7 0 1 1-14 0c0-4.8 7-13 7-13z"></path>
    {%- when 'battery' -%}
      <rect x="1" y="8" width="18" height="8" rx="2"></rect><line x1="22" y1="11" x2="22" y2="13"></line>
    {%- when 'volume-mute' -%}
      <polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"></polygon><line x1="16" y1="9" x2="21" y2="14"></line><line x1="21" y1="9" x2="16" y2="14"></line>
    {%- when 'zap' -%}
      <polygon points="13 2 4 14 11 14 10 22 20 10 13 10 13 2"></polygon>
    {%- when 'wifi' -%}
      <path d="M5 12a11 11 0 0 1 14 0"></path><path d="M8.5 15.5a6.5 6.5 0 0 1 7 0"></path><circle cx="12" cy="19" r="1"></circle>
    {%- when 'phone' -%}
      <rect x="7" y="2" width="10" height="20" rx="2"></rect><line x1="11" y1="18" x2="13" y2="18"></line>
    {%- when 'check' -%}
      <polyline points="20 6 9 17 4 12"></polyline>
    {%- when 'ruler' -%}
      <rect x="3" y="8" width="18" height="8" rx="1"></rect><path d="M7 8v3M11 8v3M15 8v3"></path>
    {%- when 'package' -%}
      <path d="M21 8l-9-5-9 5 9 5 9-5z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3-3.46"></path><path d="M14 3c.4 2.5 2.1 4.3 5 4.6"></path>
    {%- when 'twitter' -%}
      <path d="M22 5.9c-.7.3-1.5.6-2.3.7.8-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.6 1a4.1 4.1 0 0 0-7 3.7A11.6 11.6 0 0 1 3.4 4.6a4 4 0 0 0 1.3 5.5c-.6 0-1.3-.2-1.8-.5v.1c0 2 1.4 3.6 3.3 4a4.1 4.1 0 0 1-1.9.1 4.1 4.1 0 0 0 3.9 2.9A8.3 8.3 0 0 1 2 18.4a11.6 11.6 0 0 0 6.3 1.8c7.5 0 11.7-6.3 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2.1z"></path>
    {%- when 'youtube' -%}
      <rect x="2" y="5" width="20" height="14" rx="4"></rect><polygon points="10 9 15 12 10 15"></polygon>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="10"></circle><path d="M9 17.5c.5-2.2 1.4-6 1.4-6a2.7 2.7 0 0 1-.2-1.1c0-1 .6-1.8 1.4-1.8.6 0 1 .5 1 1.1 0 .7-.4 1.7-.7 2.7-.2.8.4 1.5 1.2 1.5 1.4 0 2.5-1.5 2.5-3.7 0-1.9-1.4-3.3-3.4-3.3-2.3 0-3.7 1.7-3.7 3.5 0 .7.2 1.4.6 1.8.1.1.1.2.1.3l-.2 1c0 .1-.1.2-.3.1-1-.4-1.6-1.8-1.6-2.9 0-2.4 1.7-4.6 5-4.6 2.6 0 4.6 1.9 4.6 4.3 0 2.6-1.6 4.7-3.9 4.7-.8 0-1.5-.4-1.8-.9l-.5 1.9c-.2.7-.7 1.6-1 2.1"></path>
    {%- when 'refresh' -%}
      <polyline points="1 4 1 10 7 10"></polyline><path d="M3.5 15a9 9 0 1 0 .5-9L1 10"></path>
    {%- when 'award' -%}
      <circle cx="12" cy="8" r="6"></circle><polyline points="8.2 13.5 7 22 12 19 17 22 15.8 13.5"></polyline>
    {%- when 'filter' -%}
      <polygon points="4 4 20 4 14 12 14 19 10 21 10 12 4 4"></polygon>
    {%- else -%}
      <circle cx="12" cy="12" r="9"></circle>
  {%- endcase -%}
</svg>
