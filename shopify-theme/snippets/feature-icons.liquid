{%- comment -%}
  Dynamic product feature badges, driven entirely by metafields so no unsupported
  claims are ever hardcoded. Configure boolean metafields under the `custom` namespace:
  waterproof, usb_rechargeable, body_safe, whisper_quiet, travel_lock,
  remote_control, app_control, multiple_modes.
  Usage: {% render 'feature-icons', product: product %}
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
-%}
<ul class="product-benefits">
  {%- if m.waterproof -%}
    <li>{% render 'icon', name: 'droplet' %} {{ 'products.product.feature.waterproof' | t }}</li>
  {%- endif -%}
  {%- if m.usb_rechargeable -%}
    <li>{% render 'icon', name: 'battery' %} {{ 'products.product.feature.usb_rechargeable' | t }}</li>
  {%- endif -%}
  {%- if m.body_safe -%}
    <li>{% render 'icon', name: 'shield' %} {{ 'products.product.feature.body_safe' | t }}</li>
  {%- endif -%}
  {%- if m.whisper_quiet -%}
    <li>{% render 'icon', name: 'volume-mute' %} {{ 'products.product.feature.whisper_quiet' | t }}</li>
  {%- endif -%}
  {%- if m.travel_lock -%}
    <li>{% render 'icon', name: 'lock' %} {{ 'products.product.feature.travel_lock' | t }}</li>
  {%- endif -%}
  {%- if m.remote_control -%}
    <li>{% render 'icon', name: 'zap' %} {{ 'products.product.feature.remote_control' | t }}</li>
  {%- endif -%}
  {%- if m.app_control -%}
    <li>{% render 'icon', name: 'wifi' %} {{ 'products.product.feature.app_control' | t }}</li>
  {%- endif -%}
  {%- if m.multiple_modes -%}
    <li>{% render 'icon', name: 'sparkle' %} {{ 'products.product.feature.multiple_modes' | t }}</li>
  {%- endif -%}
</ul>
