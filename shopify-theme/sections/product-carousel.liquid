{%- liquid
  assign has_products = false
  if section.settings.collection != blank and section.settings.collection.products.size > 0
    assign has_products = true
  endif
-%}
{%- if has_products or request.design_mode -%}
<section class="section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header">
      <div class="section-header__title">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="section-header__link">{{ section.settings.view_all_text }}</a>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      <div class="product-rail" data-reveal>
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state-panel">
        {% render 'icon', name: 'sparkle' %}
        <h3 class="h4">
          {%- if section.settings.collection == blank -%}No collection selected{%- else -%}This collection is empty{%- endif -%}
        </h3>
        <p>
          {%- if section.settings.collection == blank -%}
            Pick a collection in the theme editor to populate this carousel with live products.
          {%- else -%}
            Add products to &ldquo;{{ section.settings.collection.title }}&rdquo; and they'll appear here automatically.
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All" }
  ],
  "presets": [
    { "name": "Product carousel", "settings": { "heading": "Best Sellers" } }
  ]
}
{% endschema %}
