{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" data-announcement-bar data-interval="{{ section.settings.rotate_speed | times: 1000 }}">
  <div class="container">
    <div class="announcement-bar__track">
      {%- for block in section.blocks -%}
        <div class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Rotation speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Discreet Packaging" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Discreet Packaging · Worldwide Shipping" } },
        { "type": "message", "settings": { "text": "Secure Checkout · 24/7 Customer Support" } }
      ]
    }
  ]
}
{% endschema %}
