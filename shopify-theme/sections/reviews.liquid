{%- comment -%}
  Social proof / testimonials. Merchants add real customer reviews as blocks.
  If a store-wide rating metafield exists (shop.metafields.reviews.average_rating /
  review_count, e.g. from a reviews app), the summary renders from that real data;
  otherwise the summary is hidden rather than showing an invented number.
{%- endcomment -%}
{%- liquid
  assign avg_rating = shop.metafields.reviews.average_rating.value
  assign review_count = shop.metafields.reviews.review_count.value
-%}
<section class="section-padding">
  <div class="container">
    <div class="section-header">
      <div class="section-header__title">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>

    {%- if avg_rating and review_count -%}
      <div class="reviews-summary">
        <span class="reviews-summary__score">{{ avg_rating }}</span>
        <div>
          {%- assign full_stars = avg_rating | floor -%}
          <span class="rating-stars">
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}{% render 'icon', name: 'star', class: 'is-full' %}{%- else -%}{% render 'icon', name: 'star', class: 'is-empty' %}{%- endif -%}
            {%- endfor -%}
          </span>
          <p style="font-size:13px;">{{ 'products.product.based_on_reviews' | t: count: review_count }}</p>
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="reviews-rail" data-reveal>
        {%- for block in section.blocks -%}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-card__header">
              <span class="rating-stars">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}{% render 'icon', name: 'star', class: 'is-full' %}{%- else -%}{% render 'icon', name: 'star', class: 'is-empty' %}{%- endif -%}
                {%- endfor -%}
              </span>
              {%- if block.settings.verified -%}
                <span class="review-card__verified">{% render 'icon', name: 'check' %} {{ 'products.product.verified_purchase' | t }}</span>
              {%- endif -%}
            </div>
            <p class="review-card__body">"{{ block.settings.quote }}"</p>
            <span class="review-card__author">{{ block.settings.author }}</span>
            {%- if block.settings.product -%}
              <div class="review-card__product">
                {%- if block.settings.product.featured_image -%}
                  <img src="{{ block.settings.product.featured_image | image_url: width: 64 }}" alt="{{ block.settings.product.title | escape }}" loading="lazy">
                {%- endif -%}
                <a href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="placeholder-note">No reviews added yet — add customer review blocks in the theme editor, or connect a reviews app to populate this section automatically.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Social Proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Our Community" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review text", "default": "Add a real customer review here." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer Name" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true },
        { "type": "product", "id": "product", "label": "Related product (optional)" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    { "name": "Customer reviews", "settings": {} }
  ]
}
{% endschema %}
