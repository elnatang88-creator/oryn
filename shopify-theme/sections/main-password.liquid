<div class="container section-padding" style="text-align:center;padding-block:120px;max-width:480px;">
  <div class="footer-brand__logo" style="margin-bottom:16px;">{{ shop.name | default: 'ZAVYXO' }}</div>
  <h1 class="h3">{{ section.settings.heading | default: 'Something Beautiful Is Coming' }}</h1>
  <p style="margin:16px 0 32px;color:var(--color-text-secondary);">{{ section.settings.subtext }}</p>

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="email-capture" style="margin-inline:auto;">
      <input class="input" type="password" name="password" placeholder="Enter store password" required>
      <button type="submit" class="btn btn--primary">Enter</button>
    </div>
  {%- endform -%}

  {%- form 'customer', id: 'PasswordNewsletterForm' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="email-capture" style="margin:20px auto 0;">
      <input class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required>
      <button type="submit" class="btn btn--secondary">{{ 'newsletter.subscribe' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something Beautiful Is Coming" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "ZAVYXO is putting the finishing touches on something premium. Leave your email to be the first to know when we launch." }
  ]
}
{% endschema %}
