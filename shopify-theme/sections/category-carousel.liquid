<section class="section-padding">
  <div class="container">
    <div class="section-header">
      <div class="section-header__title">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="section-header__link">{{ section.settings.view_all_text }}</a>
      {%- endif -%}
    </div>

    <div class="category-rail" data-reveal>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="category-rail__item" {{ block.shopify_attributes }}>
          <span class="category-rail__ring">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="104" height="104">
            {%- else -%}
              {% render 'media-placeholder', icon: block.settings.icon, variant: forloop.index0 %}
            {%- endif -%}
          </span>
          <span>{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Overrides the icon placeholder below once uploaded" },
        {
          "type": "select",
          "id": "icon",
          "label": "Placeholder icon (used until an image is set)",
          "options": [
            { "value": "wand", "label": "Vibrator" },
            { "value": "ring", "label": "Ring" },
            { "value": "heart", "label": "Heart" },
            { "value": "rope", "label": "Rope" },
            { "value": "fabric", "label": "Fabric" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "feather", "label": "Feather" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "For Women" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category carousel",
      "blocks": [
        { "type": "category", "settings": { "label": "For Women", "icon": "wand" } },
        { "type": "category", "settings": { "label": "For Men", "icon": "ring" } },
        { "type": "category", "settings": { "label": "Couples", "icon": "heart" } },
        { "type": "category", "settings": { "label": "Vibrators", "icon": "wand" } },
        { "type": "category", "settings": { "label": "Male Pleasure", "icon": "ring" } },
        { "type": "category", "settings": { "label": "Bondage", "icon": "rope" } },
        { "type": "category", "settings": { "label": "Lingerie", "icon": "fabric" } },
        { "type": "category", "settings": { "label": "Anal Play", "icon": "ring" } },
        { "type": "category", "settings": { "label": "Lubricants", "icon": "bottle" } },
        { "type": "category", "settings": { "label": "Sale", "icon": "sparkle" } }
      ]
    }
  ]
}
{% endschema %}
