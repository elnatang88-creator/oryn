{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_only_default = product.has_only_default_variant
-%}

<product-page-root class="container section-padding" style="padding-block: clamp(24px, 4vw, 56px);" data-product-page data-product-handle="{{ product.handle }}">
  {% render 'breadcrumbs' %}

  <div class="product-page">
    {%- comment -%} ---------- GALLERY ---------- {%- endcomment -%}
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__main">
        {%- for media in product.media -%}
          {%- if forloop.first -%}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <div data-gallery-main-slot></div>
            {%- else -%}
              <img
                src="{{ media | image_url: width: 1000 }}"
                srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                loading="eager"
                fetchpriority="high"
                data-gallery-main-image
              >
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if product.media.size == 0 -%}
          <div class="shimmer" style="width:100%;height:100%;"></div>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <button type="button" class="product-gallery__nav product-gallery__nav--prev" data-gallery-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="product-gallery__nav product-gallery__nav--next" data-gallery-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        {%- endif -%}
        <button type="button" class="icon-btn product-gallery__zoom" data-gallery-zoom aria-label="Zoom image">{% render 'icon', name: 'search' %}</button>
      </div>

      <div class="product-gallery__body">
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}{% if media.media_type == 'video' or media.media_type == 'external_video' %} product-gallery__thumb--video{% endif %}"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ media.preview_image | image_url: width: 150 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="product-gallery__mobile-track" data-gallery-mobile>
        {%- for media in product.media -%}
          <div data-media-id="{{ media.id }}">
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <div data-mobile-media-slot data-media-id="{{ media.id }}"></div>
            {%- else -%}
              <img src="{{ media | image_url: width: 900 }}" alt="{{ media.alt | default: product.title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---------- PRODUCT INFO ---------- {%- endcomment -%}
    <div class="product-info">
      {%- if settings.show_vendor -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
      <h1 class="h2 product-info__title">{{ product.title }}</h1>

      {%- assign rating_metafield = product.metafields.reviews.rating.value -%}
      {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- if rating_metafield and rating_count > 0 -%}
        <div class="product-info__rating">
          {% render 'rating-stars', product: product, show_count: false %}
          <a href="#ProductReviews">{{ 'products.product.based_on_reviews' | t: count: rating_count }}</a>
        </div>
      {%- endif -%}

      <div class="product-info__price" data-product-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="sale-price" data-price>{{ current_variant.price | money }}</span>
          <span class="compare-at" data-compare-price>{{ current_variant.compare_at_price | money }}</span>
        {%- else -%}
          <span data-price>{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <div class="product-info__installment" data-installments-slot>
        {{ current_variant.price | payment_terms }}
      </div>

      {% render 'feature-icons', product: product %}

      {%- form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {%- unless has_only_default -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_index = forloop.index0
              assign is_color = false
              if option.name == 'Color' or option.name == 'Colour'
                assign is_color = true
              endif
            -%}
            <div class="variant-picker" data-option-index="{{ option_index }}">
              <div class="variant-picker__label">
                <span>{{ option.name }}</span>
                <strong data-selected-value>{{ option.selected_value }}</strong>
              </div>
              {%- if is_color -%}
                {%- comment -%} Swatch color resolves from the option value as a CSS color name (e.g. "Purple", "Black"). For custom hex values, add a metafield-driven swatch later. {%- endcomment -%}
                <div class="swatches" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    <label class="swatch{% if value == option.selected_value %} is-selected{% endif %}">
                      <input type="radio" name="option-{{ option_index }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %} class="visually-hidden" data-option-input>
                      <span class="swatch__color" style="background: {{ value | handleize }};" title="{{ value | escape }}"></span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="variant-pill-group" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    <label class="variant-pill{% if value == option.selected_value %} is-selected{% endif %}">
                      <input type="radio" name="option-{{ option_index }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %} class="visually-hidden" data-option-input>
                      {{ value }}
                    </label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="product-info__availability" data-availability>
          {%- if current_variant.available -%}
            <span class="availability-dot"></span> {{ 'products.product.in_stock' | t }}
          {%- else -%}
            <span class="availability-dot is-out"></span> {{ 'products.product.sold_out' | t }}
          {%- endif -%}
          {%- if current_variant.sku != blank -%}
            <span style="color:var(--color-text-secondary);margin-left:10px;">{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</span>
          {%- endif -%}
        </div>

        <div class="buy-box">
          <div class="buy-box__row">
            <div class="quantity-selector">
              <button type="button" data-quantity-change="decrease" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
              <input type="number" name="quantity" value="1" min="1" step="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-quantity-change="increase" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
            </div>
            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--lg"
              style="flex:1;"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-add-to-cart-text>
                {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </span>
            </button>
            <button type="button" class="icon-btn" data-wishlist-toggle="{{ product.handle }}" aria-label="{{ 'products.product.wishlist_add' | t }}">
              {% render 'icon', name: 'heart' %}
            </button>
          </div>
          <button type="button" class="btn btn--secondary btn--lg" data-buy-it-now {% unless current_variant.available %}disabled{% endunless %}>
            {{ 'products.product.buy_it_now' | t }}
          </button>
        </div>
      {%- endform -%}

      <div class="product-trust-bar">
        <div class="product-trust-bar__item">{% render 'icon', name: 'package' %} {{ 'sections.trust_strip.discreet' | t }}</div>
        <div class="product-trust-bar__item">{% render 'icon', name: 'truck' %} Tracked Shipping</div>
        <div class="product-trust-bar__item">{% render 'icon', name: 'return' %} Easy Returns</div>
        <div class="product-trust-bar__item">{% render 'icon', name: 'lock' %} Secure Checkout</div>
      </div>

      {%- comment -%} ---------- TABS ---------- {%- endcomment -%}
      <div class="product-tabs" data-product-tabs>
        <div class="product-tabs__nav" role="tablist">
          <button type="button" class="product-tabs__btn is-active" role="tab" aria-controls="tab-description">{{ 'products.product.description' | t }}</button>
          <button type="button" class="product-tabs__btn" role="tab" aria-controls="tab-features">{{ 'products.product.features' | t }}</button>
          <button type="button" class="product-tabs__btn" role="tab" aria-controls="tab-shipping">{{ 'products.product.shipping_returns' | t }}</button>
          <button type="button" class="product-tabs__btn" role="tab" aria-controls="tab-reviews">{{ 'products.product.reviews' | t }}</button>
        </div>
        <div id="tab-description" class="product-tabs__panel is-active">
          {{ product.description }}
        </div>
        <div id="tab-features" class="product-tabs__panel">
          {% render 'feature-icons', product: product %}
          {%- if product.metafields.custom.feature_notes != blank -%}
            <div style="margin-top:14px;">{{ product.metafields.custom.feature_notes.value }}</div>
          {%- endif -%}
        </div>
        <div id="tab-shipping" class="product-tabs__panel">
          {%- if section.settings.shipping_returns_text != blank -%}
            {{ section.settings.shipping_returns_text }}
          {%- else -%}
            <p>See our <a href="{{ pages.shipping.url | default: '/pages/shipping' }}">shipping</a> and <a href="{{ pages.returns.url | default: '/pages/returns' }}">returns</a> policies for full details.</p>
          {%- endif -%}
        </div>
        <div id="tab-reviews" class="product-tabs__panel">
          {% render 'product-reviews', product: product %}
        </div>
      </div>
    </div>
  </div>

  {% render 'product-fbt', product: product %}
</product-page-root>

<div class="container" id="ProductRecommendations" data-product-recommendations data-product-id="{{ product.id }}" data-url="{{ routes.product_recommendations_url }}?section_id=product-recommendations&product_id={{ product.id }}&limit=4&intent=related"></div>

<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__info">
    <p class="sticky-atc__title">{{ product.title }}</p>
    <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
  </div>
  <button type="button" class="btn btn--primary" data-sticky-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
    {{ 'products.product.add_to_cart' | t }}
  </button>
</div>

<script type="application/json" data-product-json>
  {{ product.variants | json }}
</script>
<script>
  window.ZAVYXO_PRODUCT = window.ZAVYXO_PRODUCT || {};
  window.ZAVYXO_PRODUCT['{{ product.id }}'] = {
    id: {{ product.id | json }},
    url: {{ product.url | json }},
    media: [
      {%- for media in product.media -%}
        {
          id: {{ media.id | json }},
          type: {{ media.media_type | json }},
          preview_image: {{ media.preview_image | image_url: width: 1000 | json }},
          alt: {{ media.alt | json }}
          {%- if media.media_type == 'video' -%}
          , sources: [{%- for source in media.sources -%}{ url: {{ source.url | json }}, mime_type: {{ source.mime_type | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
          {%- endif -%}
          {%- if media.media_type == 'external_video' -%}
          , embed_url: {{ media.external_id | json }}, host: {{ media.host | json }}
          {%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "richtext", "id": "shipping_returns_text", "label": "Shipping & returns text" }
  ]
}
{% endschema %}
