# ORYN — environment template. Copy to .env.local for development. Never commit real values.
# Local development works with NO variables set (embedded PostgreSQL, log email transport, no AI, demo data).

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=                      # postgres://user:pass@host:5432/oryn  (unset = embedded PGlite in .data/)
DATABASE_SSL=                      # unset = TLS required · disable · no-verify
ORYN_SECRET=                       # 32+ random chars; signs share tokens, tickets, claim cookies (required in production)
ORYN_PUBLIC_URL=                   # https://oryn.example.com — used in emails, QR codes and Wallet links
CRON_SECRET=                       # Bearer secret for /api/jobs (deletions, exports, email, automations, reminders)
ORYN_SEED_DEMO=                    # true = fictional demo accounts (never in production)
ORYN_DELETION_GRACE_DAYS=7

# ── Email (transactional only; your own SMTP server, no email SaaS) ───────────
EMAIL_TRANSPORT=                   # smtp · log (default outside production) · none (default in production → mails recorded as skipped)
SMTP_URL=                          # smtps://user:pass@mail.example.com:465
EMAIL_FROM=ORYN <no-reply@oryn.example.com>

# ── AI assistance (off unless BOTH are set and the user opted in) ─────────────
ORYN_AI_PROVIDER=                  # anthropic · unset = template fallback only
ANTHROPIC_API_KEY=

# ── Wallet (see docs/NEARBY_AND_WALLET.md) ───────────────────────────────────
ORYN_GOOGLE_WALLET_ISSUER_ID=
ORYN_GOOGLE_WALLET_SA_EMAIL=
ORYN_GOOGLE_WALLET_SA_KEY_PEM=
ORYN_APPLE_TEAM_ID=
ORYN_APPLE_PASS_TYPE_ID=
ORYN_APPLE_PASS_CERT_PEM=
ORYN_APPLE_PASS_KEY_PEM=
ORYN_APPLE_WWDR_PEM=
